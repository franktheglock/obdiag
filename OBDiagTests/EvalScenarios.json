        "codes": [
          {
            "code": "P0420",
            "status": "stored"
          }
        ],
        "vin": "1HGCM82633A004352"
      },
      "prompt": "My check engine light came on yesterday. Can you tell me what's going on and what I should do?",
      "expect": {
        "mustCallTools": [
          "get_fault_codes"
        ],
        "mustMention": [
          "P0420"
        ],
        "requireSections": [
          "caus",
          "check"
        ],
        "forbidAbstention": true,
        "maxCharacters": 6000,
        "notes": "Should ground the explanation in the stored code and give next steps."
      }
    },
