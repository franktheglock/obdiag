      "obd": {
        "readings": {
          "coolantTemperature": 92,
          "engineRPM": 780,
          "shortTermFuelTrimBank1": 3.1,
          "longTermFuelTrimBank1": 2.4,
          "catalystTempBank1Sensor1": 430
