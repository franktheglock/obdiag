<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for OBDiag/Resources/Secrets.plist.

  Copy this file to `Secrets.plist` in the same directory and fill in the keys.
  `Secrets.plist` is gitignored, so your keys stay on your machine. The
  "Copy local config" build phase bundles it into the app whenever it exists,
  so no project.yml edit or `xcodegen generate` is needed.

      cp OBDiag/Resources/Secrets.example.plist OBDiag/Resources/Secrets.plist

  These are RevenueCat *public* SDK keys (Project → API keys). They are not
  secrets — they identify the app rather than authenticating a user — but they
  are per-project, so they are kept out of the repository.

  With no Secrets.plist the app still builds and runs; the store is simply
  unavailable and everything else works.
-->
<plist version="1.0">
<dict>
	<!-- app_test… Used by Debug builds, so purchases can be exercised against
	     RevenueCat's Test Store without App Store Connect. -->
	<key>RevenueCatTestAPIKey</key>
	<string></string>

	<!-- appl_… Used by Release builds against the real App Store app. -->
	<key>RevenueCatAppStoreAPIKey</key>
	<string></string>
</dict>
</plist>
