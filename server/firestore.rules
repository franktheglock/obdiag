rules_version = '2';

// OBDiag — Firestore security rules.
//
// The client has NO direct Firestore access. Every read and write goes through
// a callable function, which authenticates the caller and applies business
// rules (plan gating, credit limits). The Admin SDK used by those functions
// bypasses these rules, so denying everything here is both the safest and the
// simplest posture: there is no client-side path to a credit balance at all.
//
// If you later add a client-side read (for example an offline balance cache),
// scope it narrowly to the owner's own document and keep it read-only:
//
//   match /users/{uid} {
//     allow read: if request.auth != null && request.auth.uid == uid;
//     allow write: if false;
//   }

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
