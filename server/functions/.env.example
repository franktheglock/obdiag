# Template for server/functions/.env — local emulator only.
#
# Firebase reads this file when you run `npm run serve`. It is gitignored, and
# it is NOT how deployed functions get their secrets: those come from Cloud
# Secret Manager, set with
#
#   npx -y firebase-tools@latest functions:secrets:set OPENROUTER_API_KEY
#
# Do not put real production keys here. These are for the emulator.
OPENROUTER_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_API_KEY=
